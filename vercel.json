{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel/output/static",
  "framework": null,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
